{
  "manifest_version": 3,
  "name": "OfferTrack - 秋招投递助手",
  "version": "2.6.2",
  "description": "轻量记录并同步招聘投递；统一字段契约与状态判断，最小化招聘站权限和 Structured State 数据面，保留安全四级自动跟进与人工确认。",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://open.feishu.cn/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "OfferTrack",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "version_name": "2.6.2",
  "optional_host_permissions": [
    "https://*/*"
  ]
}
